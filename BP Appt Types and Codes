SELECT
    RTRIM(at.DESCRIPTION)                           AS Name,
    at.APPOINTMENTCODE                              AS [Code Number],
    CASE WHEN at.RECORDSTATUS = 1 THEN 'Active'
         ELSE 'Inactive' END                        AS Status,
    ISNULL(fy2526.Cnt, 0)                           AS [# 1 Jul 25 - 30 Jun 26],
    ISNULL(fy2627.Cnt, 0)                           AS [# 1 Jul 26 - 30 Jun 27]
FROM dbo.APPOINTMENTTYPES at
LEFT JOIN (
    SELECT a.APPOINTMENTTYPE, COUNT(*) AS Cnt
    FROM dbo.APPOINTMENTS a
    LEFT JOIN dbo.CANCELLEDAPPOINTMENTS ca ON ca.APPOINTMENTID = a.RECORDID
    WHERE a.RECORDSTATUS = 1
      AND a.APPOINTMENTCODE IN (4, 5, 12, 13)
      AND a.APPOINTMENTDATE >= '2025-07-01' AND a.APPOINTMENTDATE < '2026-07-01'
      AND ca.APPOINTMENTID IS NULL
    GROUP BY a.APPOINTMENTTYPE
) fy2526 ON fy2526.APPOINTMENTTYPE = at.APPOINTMENTCODE
LEFT JOIN (
    SELECT a.APPOINTMENTTYPE, COUNT(*) AS Cnt
    FROM dbo.APPOINTMENTS a
    LEFT JOIN dbo.CANCELLEDAPPOINTMENTS ca ON ca.APPOINTMENTID = a.RECORDID
    WHERE a.RECORDSTATUS = 1
      AND a.APPOINTMENTCODE IN (4, 5, 12, 13)
      AND a.APPOINTMENTDATE >= '2026-07-01' AND a.APPOINTMENTDATE < '2027-07-01'
      AND ca.APPOINTMENTID IS NULL
    GROUP BY a.APPOINTMENTTYPE
) fy2627 ON fy2627.APPOINTMENTTYPE = at.APPOINTMENTCODE
ORDER BY at.APPOINTMENTCODE;
